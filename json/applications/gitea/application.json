{
  "name": "Gitea",
  "description": "Git with a cup of tea! Painless self-hosted all-in-one software development service, including Git hosting, code review, team collaboration, package registry and CI/CD",
  "extends": "oci-image",
  "icon": "32px-Gitea_Logo.svg.png",
  "properties": [
    { "id": "hostname", "default": "gitea" },
    { "id": "volumes", "default": "data=data,size=2G" },
    { "id": "envs", "default": "GID=1000\nGITEA__security__INSTALL_LOCK=true\nGITEA_ADMIN_USERNAME=admin\nGITEA_ADMIN_PASSWORD={{ GITEA_ADMIN_PASSWORD }}\nGITEA__database__DB_TYPE=postgres\nGITEA__database__HOST={{ POSTGRES_HOST }}:5432\nGITEA__database__NAME=gitea\nGITEA__database__PASSWD={{ POSTGRES_PASSWORD }}\nGITEA__database__USER=postgres\nGITEA__server__DOMAIN=localhost\nGITEA__server__HTTP_PORT=3000\nGITEA__server__ROOT_URL=http://localhost:3000\nGITEA__server__SSH_DOMAIN=localhost\nGITEA__server__SSH_PORT=2222\nPOSTGRES_USER=postgres\nUID=1000\nUSER_GID=1000\nUSER_UID=1000" },
    { "id": "rootfs_storage", "default": "local-zfs" },
    { "id": "volume_storage", "default": "local-zfs", "required": true },
    { "id": "oci_image", "value": "gitea/gitea:{{oci_image_tag}}" },
    { "id": "oidc_redirect_uri", "default": "https://{{hostname}}{{project_domain_suffix}}/user/oauth2/zitadel/callback" },
    { "id": "oidc_post_logout_uri", "default": "https://{{hostname}}{{project_domain_suffix}}/" },
    { "id": "wait_for_network", "value": "true" },
    { "id": "uid", "value": "1000" },
    { "id": "gid", "value": "1000" },
    { "id": "username", "value": "git" },
    { "id": "database_name", "default": "gitea" },
    { "id": "ssl_mode", "value": "native" },
    { "id": "unprivileged_port_start", "value": "443" },
    { "id": "local_https_port", "value": "443" },
    { "id": "mtls.check_file_paths", "value": "/etc/ssl/addon/mtls/gitea/cert.pem" }
  ],
  "installation": {
    "create_ct": [
      { "name": "187-create-postgres-database.json", "category": "pre_start" },
      { "name": "189-conf-set-gitea-db-owner.json", "category": "pre_start" }
    ]
  },
  "url": "https://github.com/go-gitea/gitea",
  "source": "https://github.com/go-gitea/gitea",
  "tags": [
    "development"
  ],
  "supported_addons": ["addon-oidc", "addon-ssl", "addon-mtls"],
  "oidc_roles": [
    { "key": "admin", "display_name": "Administrator" }
  ],
  "stacktype": ["postgres", "gitea"],
  "stack_usage": [
    {
      "stacktype": "gitea",
      "vars": [
        { "name": "GITEA_ADMIN_PASSWORD", "replacement": "manual" }
      ]
    },
    {
      "stacktype": "postgres",
      "vars": [
        { "name": "POSTGRES_PASSWORD", "replacement": "manual" }
      ]
    }
  ]
}
